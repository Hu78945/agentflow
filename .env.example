# Leave empty to use the deterministic fake LLM (no network, no cost).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
DATABASE_URL=postgres://agentflow:agentflow@localhost:5432/agentflow
TEMPORAL_ADDRESS=localhost:7233
PORT=3000
# Comma-separated; subdomains of each host are allowed too.
HTTP_FETCH_ALLOWED_HOSTS=example.com,en.wikipedia.org
